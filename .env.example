# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragchat
POSTGRES_USER=ragchat
POSTGRES_PASSWORD=ragchat_dev_password

# --- OpenSearch ---
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_INDEX=chunks

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Groq ---
GROQ_API_KEY=changeme
GROQ_MODEL=llama-3.3-70b-versatile

# --- Serper Dev (Google Search) ---
SERPER_API_KEY=your_serper_dev_api_key_here

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=changeme
LANGFUSE_SECRET_KEY=changeme
LANGFUSE_HOST=http://localhost:3000

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
